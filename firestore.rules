rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    match /answers/{answerId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && (resource == null || resource.data.userId == request.auth.uid) && (request.resource == null || request.resource.data.userId == request.auth.uid);
    }
    
    match /books/{bookId} {
      allow read: if request.auth != null;
      
      // Явно разрешаем создание
      allow create: if request.auth != null && request.resource.data.userId == request.auth.uid;
      
      // Явно разрешаем обновление и удаление
      allow update, delete: if request.auth != null && resource.data.userId == request.auth.uid;
    }

    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}